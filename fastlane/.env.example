# App Store Connect API key configuration for Fastlane.
#
# Copy this file to `fastlane/.env` and fill in your values. The real .env
# is gitignored. Fastlane loads it automatically when any lane runs.
#
# How to obtain these values:
#   1. https://appstoreconnect.apple.com/access/integrations/api → Keys tab
#   2. Click "+" → name the key → Access: "App Manager" (minimum)
#   3. Download the .p8 file IMMEDIATELY — you only get one chance
#   4. Copy the Key ID (10-char string in the row) and Issuer ID (UUID at top)
#
# Recommended local storage for the .p8:
#   mkdir -p ~/.appstoreconnect/private_keys
#   mv ~/Downloads/AuthKey_XXXXXXXXXX.p8 ~/.appstoreconnect/private_keys/
#   chmod 600 ~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
